<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="06-create-package-categories-table" author="healthconnect">
        <createTable tableName="package_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="category_code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="payer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="package_categories"
                baseColumnNames="payer_id"
                constraintName="fk_package_categories_payer"
                referencedTableName="payers"
                referencedColumnNames="id"/>

        <createIndex tableName="package_categories" indexName="idx_package_category_payer">
            <column name="payer_id"/>
        </createIndex>
        <createIndex tableName="package_categories" indexName="idx_package_category_code">
            <column name="category_code"/>
        </createIndex>
        <createIndex tableName="package_categories" indexName="idx_package_category_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="06-create-package-category-limits-table" author="healthconnect">
        <createTable tableName="package_category_limits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="limit_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="package_category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contract_header_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="limit_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="limit_value" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="period_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="reset_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="package_category_limits"
                baseColumnNames="package_category_id"
                constraintName="fk_category_limits_category"
                referencedTableName="package_categories"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="package_category_limits"
                baseColumnNames="contract_header_id"
                constraintName="fk_category_limits_contract"
                referencedTableName="contract_headers"
                referencedColumnNames="id"/>

        <createIndex tableName="package_category_limits" indexName="idx_category_limit_contract">
            <column name="contract_header_id"/>
        </createIndex>
        <createIndex tableName="package_category_limits" indexName="idx_category_limit_category">
            <column name="package_category_id"/>
        </createIndex>
        <createIndex tableName="package_category_limits" indexName="idx_category_limit_period">
            <column name="period_type"/>
            <column name="reset_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="06-create-package-category-usage-table" author="healthconnect">
        <createTable tableName="package_category_usage">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usage_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="insured_person_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category_limit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="period_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="used_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="used_quantity" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="used_visits" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="service_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="service_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="service_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="claim_uuid" type="VARCHAR(255)"/>
            <column name="provided_service_uuid" type="VARCHAR(255)"/>
            <column name="notes" type="TEXT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="package_category_usage"
                baseColumnNames="insured_person_id"
                constraintName="fk_usage_insured_person"
                referencedTableName="insured"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="package_category_usage"
                baseColumnNames="category_limit_id"
                constraintName="fk_usage_category_limit"
                referencedTableName="package_category_limits"
                referencedColumnNames="id"/>

        <createIndex tableName="package_category_usage" indexName="idx_usage_insured_category">
            <column name="insured_person_id"/>
            <column name="category_limit_id"/>
        </createIndex>
        <createIndex tableName="package_category_usage" indexName="idx_usage_period">
            <column name="period_start_date"/>
            <column name="period_end_date"/>
        </createIndex>
        <createIndex tableName="package_category_usage" indexName="idx_usage_claim">
            <column name="claim_uuid"/>
        </createIndex>
        <createIndex tableName="package_category_usage" indexName="idx_usage_service">
            <column name="service_uuid"/>
        </createIndex>
    </changeSet>

    <changeSet id="06-create-service-category-mappings-table" author="healthconnect">
        <createTable tableName="service_category_mappings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mapping_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="contract_detail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="package_category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="consumes_from_limit" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="service_category_mappings"
                baseColumnNames="contract_detail_id"
                constraintName="fk_mapping_contract_detail"
                referencedTableName="contract_details"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="service_category_mappings"
                baseColumnNames="package_category_id"
                constraintName="fk_mapping_package_category"
                referencedTableName="package_categories"
                referencedColumnNames="id"/>

        <createIndex tableName="service_category_mappings" indexName="idx_service_category_contract">
            <column name="contract_detail_id"/>
        </createIndex>
        <createIndex tableName="service_category_mappings" indexName="idx_service_category_package">
            <column name="package_category_id"/>
        </createIndex>
        <createIndex tableName="service_category_mappings" indexName="idx_service_category_unique">
            <column name="contract_detail_id"/>
            <column name="package_category_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
