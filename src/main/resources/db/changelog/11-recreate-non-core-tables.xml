    <changeSet id="create-package-category-usage-table" author="filmon">
        <comment>Create package_category_usage table</comment>

        <createTable tableName="package_category_usage">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usage_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="insured_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="service_uuid" type="VARCHAR(255)">
