                                 referencedTableName="medication_dispensing" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="medication_dispensing_items" baseColumnNames="contract_detail_id"
                                 constraintName="fk_dispensing_item_contract_detail"
                                 referencedTableName="contract_details" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="create-claims-table" author="filmon">
        <comment>Create claims table</comment>

        <createTable tableName="claims">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="claim_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="claim_number" type="BIGINT">
                <constraints unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="provider_uuid" type="VARCHAR(255)"/>
            <column name="payer_uuid" type="VARCHAR(255)"/>
            <column name="mrn_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="visit_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="claim_type" type="VARCHAR(50)"/>
            <column name="diagnosis" type="TEXT"/>
            <column name="treatment_summary" type="TEXT"/>
            <column name="submission_date" type="TIMESTAMP"/>
            <column name="approval_date" type="TIMESTAMP"/>
            <column name="rejection_date" type="TIMESTAMP"/>
            <column name="rejection_reason" type="TEXT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <createIndex tableName="claims" indexName="idx_claim_payer_status">
            <column name="payer_uuid"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="claims" indexName="idx_claim_provider_status">
            <column name="provider_uuid"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="claims" indexName="idx_claim_payer_provider_status">
            <column name="payer_uuid"/>
            <column name="provider_uuid"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

