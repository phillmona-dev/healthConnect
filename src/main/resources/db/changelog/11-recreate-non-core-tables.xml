<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-sequences" author="filmon">
        <comment>Create sequences for non-core tables</comment>
        
        <!-- Create sequences -->
        <createSequence sequenceName="package_category_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="batch_record_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="contract_header_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="contract_detail_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="drug_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="servicelist_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="medication_dispensing_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="medication_dispensing_item_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="employee_dependant_group_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="dependant_group_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="employee_insured_group_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="payment_transaction_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="provided_service_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="benefit_balance_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="dependant_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="package_category_limit_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="package_category_usage_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="service_category_mapping_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="failed_external_dispensing_log_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="contract_detail_employee_group_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_attachment_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_comment_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_log_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_payment_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="claim_item_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="batch_log_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="password_reset_token_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="refresh_token_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="profile_picture_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="create-package-categories-table" author="filmon">
        <comment>Create package_categories table</comment>
        
        <createTable tableName="package_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="category_code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="provider_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        
        <createIndex tableName="package_categories" indexName="idx_package_category_provider">
            <column name="provider_uuid"/>
        </createIndex>
        <createIndex tableName="package_categories" indexName="idx_package_category_code">
            <column name="category_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-drugs-table" author="filmon">
        <comment>Create drugs table</comment>
        
        <createTable tableName="drugs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="drug_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="drug_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="drug_code" type="VARCHAR(50)"/>
            <column name="generic_name" type="VARCHAR(255)"/>
            <column name="brand_name" type="VARCHAR(255)"/>
            <column name="strength" type="VARCHAR(100)"/>
            <column name="dosage_form" type="VARCHAR(100)"/>
            <column name="route_of_administration" type="VARCHAR(100)"/>
            <column name="manufacturer" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="unit_price" type="DECIMAL(10,2)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="provider_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        
        <createIndex tableName="drugs" indexName="idx_drug_provider">
            <column name="provider_uuid"/>
        </createIndex>
        <createIndex tableName="drugs" indexName="idx_drug_code">
            <column name="drug_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-servicelists-table" author="filmon">
        <comment>Create servicelists table</comment>
        
        <createTable tableName="servicelists">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="service_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="service_code" type="VARCHAR(50)"/>
            <column name="generated_service_id" type="VARCHAR(50)"/>
            <column name="description" type="TEXT"/>
            <column name="price" type="DECIMAL(10,2)"/>
            <column name="service_type" type="VARCHAR(100)"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="provider_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        
        <addForeignKeyConstraint baseTableName="servicelists" baseColumnNames="provider_id"
                                 constraintName="fk_servicelist_provider"
                                 referencedTableName="providers" referencedColumnNames="id"/>
        
        <createIndex tableName="servicelists" indexName="idx_servicelist_provider">
            <column name="provider_id"/>
        </createIndex>
        <createIndex tableName="servicelists" indexName="idx_servicelist_code">
            <column name="service_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-contract-headers-table" author="filmon">
        <comment>Create contract_headers table</comment>

        <createTable tableName="contract_headers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="contract_header_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="contract_number" type="VARCHAR(100)"/>
            <column name="contract_name" type="VARCHAR(255)"/>
            <column name="contract_description" type="TEXT"/>
            <column name="contract_code" type="VARCHAR(50)"/>
            <column name="approved_by" type="VARCHAR(255)"/>
            <column name="approval_date" type="DATE"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="remark" type="TEXT"/>
            <column name="prepared_by" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="termination_date" type="DATE"/>
            <column name="termination_reason" type="VARCHAR(255)"/>
            <column name="termination_notes" type="TEXT"/>
            <column name="terminated_by" type="VARCHAR(255)"/>
            <column name="termination_request_date" type="TIMESTAMP"/>
            <column name="co_payment_percentage" type="DOUBLE"/>
            <column name="payer_id" type="BIGINT"/>
            <column name="provider_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="contract_headers" baseColumnNames="payer_id"
                                 constraintName="fk_contract_header_payer"
                                 referencedTableName="payers" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="contract_headers" baseColumnNames="provider_id"
                                 constraintName="fk_contract_header_provider"
                                 referencedTableName="providers" referencedColumnNames="id"/>

        <createIndex tableName="contract_headers" indexName="idx_contract_header_payer_provider">
            <column name="payer_id"/>
            <column name="provider_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-contract-details-table" author="filmon">
        <comment>Create contract_details table</comment>

        <createTable tableName="contract_details">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="contract_detail_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="contract_header_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="service_uuid" type="VARCHAR(255)"/>
            <column name="drug_uuid" type="VARCHAR(255)"/>
            <column name="negotiated_price" type="DECIMAL(10,2)"/>
            <column name="co_payment_percentage" type="DOUBLE"/>
            <column name="co_payment_amount" type="DECIMAL(10,2)"/>
            <column name="deductible_amount" type="DECIMAL(10,2)"/>
            <column name="maximum_coverage" type="DECIMAL(10,2)"/>
            <column name="item_type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="effective_date" type="DATE"/>
            <column name="expiry_date" type="DATE"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <createIndex tableName="contract_details" indexName="idx_contract_detail_header_service">
            <column name="contract_header_uuid"/>
            <column name="service_uuid"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-dependants-table" author="filmon">
        <comment>Create dependants table</comment>

        <createTable tableName="dependants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dependant_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="father_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="grand_father_name" type="VARCHAR(100)"/>
            <column name="gender" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_birth" type="DATE"/>
            <column name="relationship" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="address" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="insured_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="dependants" baseColumnNames="insured_id"
                                 constraintName="fk_dependant_insured"
                                 referencedTableName="insured" referencedColumnNames="id"/>

        <createIndex tableName="dependants" indexName="idx_dependant_insured">
            <column name="insured_id"/>
        </createIndex>
        <createIndex tableName="dependants" indexName="idx_dependant_search">
            <column name="first_name"/>
            <column name="father_name"/>
            <column name="grand_father_name"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-medication-dispensing-table" author="filmon">
        <comment>Create medication_dispensing table</comment>

        <createTable tableName="medication_dispensing">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dispensing_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="insured_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="provider_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="payer_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="dispensing_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)"/>
            <column name="insurance_coverage" type="DECIMAL(10,2)"/>
            <column name="patient_responsibility" type="DECIMAL(10,2)"/>
            <column name="claim_status" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT"/>
            <column name="source" type="VARCHAR(20)" defaultValue="INPUT"/>
            <column name="invoice_number" type="VARCHAR(100)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <createIndex tableName="medication_dispensing" indexName="idx_medication_dispensing_insured">
            <column name="insured_uuid"/>
        </createIndex>
        <createIndex tableName="medication_dispensing" indexName="idx_medication_dispensing_provider">
            <column name="provider_uuid"/>
        </createIndex>
        <createIndex tableName="medication_dispensing" indexName="idx_medication_dispensing_payer">
            <column name="payer_uuid"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-medication-dispensing-items-table" author="system">
        <comment>Create medication_dispensing_items table</comment>

        <createTable tableName="medication_dispensing_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="item_uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="dispensing_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contract_detail_id" type="BIGINT"/>
            <column name="medication_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="medication_code" type="VARCHAR(50)"/>
            <column name="quantity" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="unit_of_measure" type="VARCHAR(50)"/>
            <column name="unit_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="dosage_instructions" type="TEXT"/>
            <column name="route" type="VARCHAR(100)"/>
            <column name="item_type" type="VARCHAR(20)" defaultValue="DRUG"/>
            <column name="remark" type="TEXT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
