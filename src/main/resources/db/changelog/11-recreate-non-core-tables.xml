    <!-- Add foreign key constraints for missing tables -->
    <changeSet id="add-missing-foreign-keys" author="filmon">
        <comment>Add foreign key constraints for missing claim-related tables</comment>

        <!-- BatchLog foreign keys -->
        <addForeignKeyConstraint
                baseTableName="batch_logs"
                baseColumnNames="batch_id"
                referencedTableName="batch_records"
                referencedColumnNames="id"
                constraintName="fk_batch_logs_batch_record"/>

        <!-- ClaimAttachment foreign keys -->
        <addForeignKeyConstraint
                baseTableName="claim_attachments"
                baseColumnNames="claim_id"
                referencedTableName="claims"
                referencedColumnNames="id"
                constraintName="fk_claim_attachments_claim"/>

        <!-- ClaimComment foreign keys -->
        <addForeignKeyConstraint
                baseTableName="claim_comments"
                baseColumnNames="claim_id"
                referencedTableName="claims"
                referencedColumnNames="id"
                constraintName="fk_claim_comments_claim"/>

        <!-- ClaimItem foreign keys -->
        <addForeignKeyConstraint
                baseTableName="claim_items"
                baseColumnNames="claim_id"
