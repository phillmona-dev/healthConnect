<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="17-make-provider-uuid-nullable-package-categories" author="system">
        <comment>Make provider_uuid column nullable in package_categories table since packages are created by payers, not providers</comment>
        
        <!-- Drop the NOT NULL constraint on provider_uuid -->
        <dropNotNullConstraint 
            tableName="package_categories" 
            columnName="provider_uuid" 
            columnDataType="VARCHAR(255)"/>
            
        <rollback>
            <!-- Rollback: Add NOT NULL constraint back -->
            <addNotNullConstraint 
                tableName="package_categories" 
                columnName="provider_uuid" 
                columnDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
